# Copia este archivo a .env.local (desarrollo) y configura las mismas
# variables en el dashboard de Render (producción) -- .env.local nunca se
# sube a git (ver .gitignore).

# ---------- Obligatorias ----------

# Cadena de conexión de Postgres (Neon, Render Postgres, etc.)
DATABASE_URL=postgres://usuario:password@host:5432/basededatos

# Password compartido del panel de equipo (/reportes). Cámbialo por uno
# tuyo -- no dejes el valor de ejemplo en producción.
EQUIPO_PASSWORD=cambia-esto

# Secreto para firmar las cookies de sesión (equipo y refugios). Genera uno
# aleatorio largo, ej. con: openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-algo-aleatorio-y-largo

# ---------- Cloudinary (fotos de gatos, productos y refugios) ----------
# Se obtienen creando una cuenta gratis en cloudinary.com -- sin esto
# configurado, la subida de fotos queda deshabilitada en los formularios.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Mercado Pago (donativos, tienda y suscripciones) ----------
# Access Token del panel de desarrolladores de Mercado Pago
# (mercadopago.com.mx/developers/panel/app) -- usa el de PRODUCCIÓN para
# cobrar de verdad, o uno de prueba (TEST-...) para probar sin mover dinero
# real. Sin esto, donativos/tienda/suscripciones quedan deshabilitados.
MERCADOPAGO_ACCESS_TOKEN=

# Public key (del mismo panel) -- esta SÍ se expone en el navegador, es la
# que usa el formulario de tarjeta embebido (Bricks) de /suscripcion. Debe
# llevar el prefijo NEXT_PUBLIC_ para que Next.js la incluya en el bundle
# del cliente.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# URL pública del sitio -- se usa para armar las URLs de regreso y el
# webhook que se le manda a Mercado Pago. Sin esto, cae de vuelta a
# https://adopta.ceroluzcerogas.com
SITE_URL=https://adopta.ceroluzcerogas.com

# Secreto para proteger /api/cron/suscripciones (el disparador de
# recordatorios de suscripción) -- genera uno aleatorio (ej. openssl rand
# -hex 24) y configura el mismo valor en el cron externo (ver
# claude/estado-del-sistema.md para instrucciones de cron-job.org).
CRON_SECRET=

# ---------- Correo (Resend -- confirmaciones y recordatorios de suscripción) ----------
# Se obtiene creando una cuenta gratis en resend.com/signup y una API key
# en su dashboard. Sin esto, el sistema sigue funcionando pero no manda
# correos (queda registrado en los logs).
RESEND_API_KEY=

# Remitente de los correos -- requiere verificar un dominio propio en
# resend.com/domains para poder usar una dirección real (ej.
# notificaciones@ceroluzcerogas.com) y para que los correos le lleguen a
# cualquier adoptante, no solo a la cuenta de Resend. Mientras no se
# configure, cae de vuelta al remitente de pruebas de Resend (que solo
# entrega a la cuenta registrada en Resend).
EMAIL_REMITENTE="Adopción de gatos <notificaciones@ceroluzcerogas.com>"
